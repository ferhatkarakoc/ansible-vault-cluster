ui = true
disable_mlock = true

storage "raft" {
  path = "/opt/vault/data"
  node_id = "{{ inventory_hostname }}"

{% for host in groups['vault_cluster'] %}
{% if hostvars[host]['ansible_host'] != ansible_host %}
  retry_join {
    leader_api_addr = "https://{{ hostvars[host]['ansible_host'] }}:8200"
    tls_ca_file = "/opt/vault/tls/vault.crt"
  }
{% endif %}
{% endfor %}
}

listener "tcp" {
  address = "0.0.0.0:8200"
  cluster_address = "{{ ansible_host }}:8201"

  tls_disable = 0
  tls_cert_file = "/opt/vault/tls/vault.crt"
  tls_key_file  = "/opt/vault/tls/vault.key"
}

api_addr = "https://{{ ansible_host }}:8200"
cluster_addr = "https://{{ ansible_host }}:8201"
max_lease_ttl = "768h"
default_lease_ttl = "768h"